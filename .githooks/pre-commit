#!/usr/bin/env sh
# Runs the checks for the parts touched by the commit.
# Enable once per clone: git config core.hooksPath .githooks
set -eu

root=$(git rev-parse --show-toplevel)
staged=$(git diff --cached --name-only --diff-filter=ACMR)

if echo "$staged" | grep -q '^backend/'; then
  (cd "$root/backend" && uv run ruff check . && uv run ruff format --check . \
    && uv run mypy --strict src && uv run pytest -q)
fi

if echo "$staged" | grep -q '^frontend/'; then
  (cd "$root/frontend" && npx tsc --noEmit && npx tsc --noEmit -p e2e && npx eslint . && npx vitest run)
fi
